{
  "name": "cse-analyser",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "format:write": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "e2e": "dotenv playwright test",
    "e2e:ui": "dotenv playwright test --ui"
  },
  "lint-staged": {
    "src/**/*.{ts,html,scss}": [
      "prettier --write"
    ],
    "src/**/*.ts": [
      "eslint --fix --max-warnings=0"
    ]
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@supabase/supabase-js": "^2.106.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.13",
    "@angular/cli": "^21.2.13",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "angular-eslint": "21.4.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.0.6",
    "prettier": "^3.8.1",
    "supabase": "^2.102.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  }
}
